# Переменные для настройки Kubernetes/Vault окружения Bastyle.
# Скопируйте файл в .env, заполните значения и выполните:
# set -a; source .env; set +a

# Адрес Vault API. Для локального port-forward:
# kubectl port-forward -n vault svc/vault 8200:8200
VAULT_ADDR=http://127.0.0.1:8200

# Root token или token с правами на настройку engines, policy и auth/kubernetes.
VAULT_TOKEN=change-me-vault-token

# Telegram token от BotFather. Хранится в Vault KV kv/bastyle/telegram.
TELEGRAM_TOKEN=change-me-telegram-token

# Админ-пароль PostgreSQL пользователя, которым Vault database engine создает
# динамических runtime-пользователей приложения.
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin-password

# Админ-пароль RabbitMQ пользователя, которым Vault rabbitmq engine создает
# динамических runtime-пользователей приложения.
RABBITMQ_ADMIN_PASSWORD=change-me-rabbitmq-admin-password

# Опциональные настройки bootstrap-vault.sh.
BASTYLE_NAMESPACE=bastyle
BASTYLE_SERVICE_ACCOUNT=blacklist
POSTGRES_HOST=bastyle-postgresql-rw
POSTGRES_PORT=5432
POSTGRES_DATABASE=bastyle
POSTGRES_ADMIN_USER=vault_admin
RABBITMQ_HTTP_URL=http://bastyle-rabbitmq:15672
RABBITMQ_ADMIN_USER=vault_admin
