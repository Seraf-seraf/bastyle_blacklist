FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
	PYTHONUNBUFFERED=1 \
	HF_HOME=/opt/huggingface

WORKDIR /app

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

COPY services/aimatcher/ai_vector_service/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir --upgrade pip \
	&& pip install --no-cache-dir -r requirements.txt

RUN huggingface-cli download nomic-ai/nomic-embed-vision-v1.5 --revision e3a725bce72db07ca4adb1d83da08903f3ee02f8 \
	&& useradd --system --home-dir /var/lib/bastyle --create-home --shell /usr/sbin/nologin bastyle \
	&& mkdir -p /app/infra/config /var/lib/bastyle "${HF_HOME}" \
	&& chown -R bastyle:bastyle /var/lib/bastyle "${HF_HOME}"

COPY services/aimatcher/ai_vector_service ./ai_vector_service

USER bastyle

EXPOSE 8080

CMD ["python", "-m", "ai_vector_service.main"]
