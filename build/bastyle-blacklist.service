[Unit]
Description=Bastyle Blacklist Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bastyle_bot
Group=bastyle_bot
WorkingDirectory=/var/lib/bastyle

Environment=GOMAXPROCS=1
Environment="HTTPS_PROXY=http://<АЙПИ ПРОКСИ>:7890"
Environment="HTTP_PROXY=http://<АЙПИ ПРОКСИ>:7890"

ExecStart=/usr/local/bin/bastyle-blacklist -config /etc/bastyle/config.yaml

Restart=on-failure
RestartSec=5
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
